{
 ".vimrc".text = ''
	syntax on
	filetype on
	set number
	set relativenumber
	set tabstop=2
	set softtabstop=2
	set shiftwidth=2
	set textwidth=80
	set autoindent
	set smartindent
	set showmatch
	set hlsearch
	set smartcase
	set hidden
	
	set nobackup
	set nowb
	set noswapfile
	
	set scrolloff=3
	'';
}
